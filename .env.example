## Groq
GROQ_API_KEY=

## Modelos usados pelos agentes (podem ser ajustados; ver modelos disponíveis em https://console.groq.com/docs/models)
GROQ_MODEL_EXTRACTION=openai/gpt-oss-120b
GROQ_MODEL_QA=openai/gpt-oss-120b
GROQ_MODEL_COMPARISON=openai/gpt-oss-120b
GROQ_MODEL_REPORT=openai/gpt-oss-120b

## Banco de dados
DATABASE_URL=sqlite:///./data/insurminds.db

## Diretório de armazenamento de uploads
UPLOAD_DIR=./data/uploads
